# PARR Primetax — variaveis de ambiente (copie para .env; .env nunca vai para o git)

# --- Obrigatorias (em producao o boot falha sem elas) ---
DATABASE_URL=mysql://usuario:senha@host:3306/parr
# Minimo 32 caracteres (ex.: openssl rand -base64 48)
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria-com-32-ou-mais-caracteres
# Origem publica do app, sem barra final. Usada na redirect URI do Google Calendar.
PUBLIC_BASE_URL=https://parr.primetax.com.br

# --- Servidor ---
NODE_ENV=production
# Endereco de escuta. 127.0.0.1 = so o nginx local alcanca o app (default se ausente).
HOST=127.0.0.1
# Porta fixa: se estiver ocupada o processo encerra (nao ha troca automatica de porta).
PORT=3000

# --- Notificacao de novo lead por e-mail (SMTP) ---
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=usuario
SMTP_PASS=senha
SMTP_FROM=PARR Primetax <parr@primetax.com.br>
# Um ou mais destinatarios, separados por virgula
NOTIFY_EMAIL_TO=marcelo@primetax.com.br

# --- Google Calendar (opcional) ---
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# --- Pipedrive (opcional) ---
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_DOMAIN=

# --- Somente para `pnpm tsx scripts/criar-admin.ts` (nao deixar no .env do servidor) ---
# ADMIN_EMAIL=
# ADMIN_NOME=
